[Unit]
Description=nudge (GCal reminders + event creation, via Telegram)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
# notify + WatchdogSec: nudge pings systemd each tick, so a wedged loop
# (not just a crash) gets restarted. See nudge/health.py.
Type=notify
NotifyAccess=main
WatchdogSec=120
User=adam
WorkingDirectory=/home/adam/Projects/nudge
ExecStart=/home/adam/Projects/nudge/venv/bin/python -m nudge run
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
